sequenceDiagram
    participant Agent as "Agent (MCP)"
    participant Operator as "Operator (terminal)"
    participant Preview as "PreviewTool"
    participant Store as "ConfirmationStore"
    participant CLI as "CLI confirm"
    participant Client as "KTalkClient"

    Agent->>Preview: "preview(тема, время, комната, участники, ...)"
    Preview->>Preview: "body = build_allowlist(params)"
    Note over Preview: "NFR-9: любое поле None -> отказ до сети,<br/>до обращения к ConfirmationStore"
    Preview->>Store: "issue(hash(body))"
    Store-->>Preview: "confirmation_id, TTL"
    Preview-->>Agent: "предпросмотр + confirmation_id『сетевого вызова на запись нет』"
    Note over Agent,Operator: "Agent показывает предпросмотр Operator;<br/>PreviewTool одинаково доступен из CLI напрямую, без агента"

    Operator->>CLI: "create-meeting confirm --id ...『те же параметры』"
    CLI->>CLI: "isatty(stdin) and isatty(stdout)?"

    alt "не терминал (пайп/скрипт)"
        CLI-->>Operator: "отказ『нужен интерактивный терминал』, сети нет, Store не тронут"
    else "интерактивный терминал"
        CLI->>CLI: "body' = build_allowlist(params)"
        CLI->>Store: "match(confirmation_id, hash(body'))"
        alt "id не найден / TTL истёк / хеш не совпал / уже consumed"
            Store-->>CLI: "reject"
            CLI-->>Operator: "явный отказ『повторите предпросмотр』, сети нет"
        else "совпадение"
            Store-->>CLI: "ok"
            CLI->>Store: "consume(confirmation_id)"
            Note over Store: "помечен потреблённым ДО сетевого вызова"
            CLI->>Client: "create_meeting(body')"
            Client->>Client: "POST /calendar『ровно одна попытка, без retry』"
            alt "сетевая ошибка/timeout"
                Client-->>CLI: "network error"
                CLI-->>Operator: "исход неизвестен -- проверьте календарь (FR-18) перед новой попыткой;<br/>id уже consumed, нужен новый предпросмотр"
            else "2xx"
                Client-->>CLI: "ok"
                CLI-->>Operator: "встреча создана『эхо полей』"
            else "4xx/5xx от сервера"
                Client-->>CLI: "server error"
                CLI-->>Operator: "читаемая ошибка, встреча не создана"
            end
        end
    end
